# ==============================================================================
# NEXAFINANCE ENVIRONMENT VARIABLES
# ==============================================================================

# 1. DATABASE (PostgreSQL)
# Lokal Docker: postgresql://postgres:postgrespassword@localhost:5432/nexafinance?schema=public
# Produksi Neon.tech: postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nexafinance?schema=public"

# 2. BETTER AUTH (Autentikasi Session & Cookie)
# Generate secret 32 karakter acak (contoh: openssl rand -base64 32)
BETTER_AUTH_SECRET="nexafinance_production_secret_key_32_characters_long_min"
# URL aplikasi (Lokal: http://localhost:3000 | Vercel: https://nama-projek.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"

# 3. WHATSAPP NOTIFICATION BOT
# Driver: "fonnte" (default), "wablas", atau "mock" (untuk dev tanpa token)
WHATSAPP_DRIVER="mock"
# Token Fonnte (Dapatkan gratis di https://fonnte.com)
FONNTE_TOKEN=""
# Token Wablas (Opsional jika ingin menggunakan Wablas https://wablas.com)
WABLAS_TOKEN=""
WABLAS_SERVER="https://bdg.wablas.com"

# 4. ARTIFICIAL INTELLIGENCE (AI)
# Groq API Key untuk Natural Language Processing (Dapatkan gratis di https://console.groq.com)
GROQ_API_KEY=""
# Google Gemini API Key untuk Vision OCR Struk & Financial Advisor (Dapatkan gratis di https://aistudio.google.com)
GEMINI_API_KEY=""

# 5. OPTIONAL: UPSTASH REDIS (Untuk Rate Limiting Global Terdistribusi)
# Dapatkan gratis di https://upstash.com (opsional, in-memory limiter aktif otomatis jika kosong)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
